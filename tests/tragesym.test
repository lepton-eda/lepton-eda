(test-begin "lepton-tragesym test1")

(test-group-with-cleanup "lepton-tragesym test1"
  (test-setup)

  (chdir *testdir*)

  (receive (<status> <stdout> <stderr>)
      (command-values lepton-tragesym
                      (build-filename *examples-dir* "test1.src")
                      "test1.sym")
    (test-eq EXIT_SUCCESS <status>)
    (test-run-success "diff"
                      (build-filename *examples-dir* "test1.sym")
                      (build-filename *testdir* "test1.sym"))
    (test-assert
        (string-contains <stderr>
                         "Empty attribute \"use-license\" in the geda_attr section."))
    (test-assert
        (string-contains <stderr>
                         "Empty attribute \"dist-license=\" in the geda_attr section."))
    (test-assert
        (string-contains <stderr>
                         "\"device\" attribute missing."))
    (test-assert
        (string-contains <stderr>
                         "\"footprint\" attribute missing."))
    (test-assert
        (string-contains <stderr>
                         "\"author\" attribute missing."))
    (test-assert
        (string-contains <stderr>
                         "\"documentation\" attribute missing."))
    (test-assert
        (string-contains <stderr>
                         "\"description\" attribute missing."))
    (test-assert
        (string-contains <stderr>
                         "\"numslots\" attribute missing."))
    (test-assert
        (string-contains <stderr>
                         "\"symversion\" attribute missing."))
    (test-assert
        (string-contains <stderr>
                         "\"dist-license\" attribute missing."))
    (test-assert
        (string-contains <stderr>
                         "\"use-license\" attribute missing."))
    (test-assert
        (string-contains <stderr>
                         "Note: use sym_width to adjust symbol width if texts overlap.")))

  (test-teardown))

(test-end "lepton-tragesym test1")


