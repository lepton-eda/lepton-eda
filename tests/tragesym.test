(use-modules (ice-9 receive))

(load-from-path "env.scm")

(define help-string "lepton-tragesym INPUT-FILE OUTPUT-FILE")


(test-begin "lepton-tragesym -h")

(receive (<status> <stdout> <stderr>)
    (command-values lepton-tragesym "-h")
  (test-eq EXIT_SUCCESS <status>)
  (test-assert (string-contains <stdout> help-string)))

(test-end "lepton-tragesym -h")


(test-begin "lepton-tragesym --help")

(receive (<status> <stdout> <stderr>)
    (command-values lepton-tragesym "--help")
  (test-eq EXIT_SUCCESS <status>)
  (test-assert (string-contains <stdout> help-string)))

(test-end "lepton-tragesym --help")


(test-begin "lepton-tragesym -V")

(receive (<status> <stdout> <stderr>)
    (command-values lepton-tragesym "-V")
  (test-eq EXIT_SUCCESS <status>)
  (test-assert (string-contains <stdout> "Lepton EDA"))
  (test-assert (string-contains <stdout> "Copyright"))
  (test-assert (string-contains <stdout> "There is NO WARRANTY")))

(test-end "lepton-tragesym -V")


(test-begin "lepton-tragesym --version")

(receive (<status> <stdout> <stderr>)
    (command-values lepton-tragesym "--version")
  (test-eq EXIT_SUCCESS <status>)
  (test-assert (string-contains <stdout> "Lepton EDA"))
  (test-assert (string-contains <stdout> "Copyright"))
  (test-assert (string-contains <stdout> "There is NO WARRANTY")))

(test-end "lepton-tragesym --version")


(define cwd (getcwd))
(define *testdir* (build-filename (getcwd) "tragesym-tmp"))

;;; Setup/teardown directories/files needed by tests.
(define (test-setup)
  (mkdir *testdir*)
  (chdir *testdir*))

(define (test-teardown)
  (chdir cwd)
  (system* "rm" "-rf" *testdir*))


(define *examples-dir*
  (build-filename *abs-top-srcdir* "tools" "tragesym" "examples"))


(test-begin "lepton-tragesym 4099")

(test-group-with-cleanup "lepton-tragesym 4099"
  (test-setup)

  (chdir *testdir*)

  (receive (<status> <stdout> <stderr>)
      (command-values lepton-tragesym
                      (build-filename *examples-dir* "4099.src")
                      "4099.sym")
    (test-eq EXIT_SUCCESS <status>)
    (test-run-success "diff"
                      (build-filename *examples-dir* "4099.sym")
                      (build-filename *testdir* "4099.sym"))
    (test-assert
        (string-contains <stderr>
                         "\"device\" attribute missing."))
    (test-assert
        (string-contains <stderr>
                         "\"footprint\" attribute missing."))
    (test-assert
        (string-contains <stderr>
                         "\"author\" attribute missing."))
    (test-assert
        (string-contains <stderr>
                         "\"documentation\" attribute missing."))
    (test-assert
        (string-contains <stderr>
                         "\"description\" attribute missing."))
    (test-assert
        (string-contains <stderr>
                         "\"numslots\" attribute missing."))
    (test-assert
        (string-contains <stderr>
                         "\"symversion\" attribute missing."))
    (test-assert
        (string-contains <stderr>
                         "\"dist-license\" attribute missing."))
    (test-assert
        (string-contains <stderr>
                         "\"use-license\" attribute missing."))
    (test-assert
        (not (string-contains <stderr>
                              "Note: use sym_width to adjust symbol width if texts overlap."))))

  (test-teardown))

(test-end "lepton-tragesym 4099")


